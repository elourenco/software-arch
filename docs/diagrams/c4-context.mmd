flowchart TB
  classDef actor fill:#fff7ed,stroke:#c2410c,color:#431407
  classDef app fill:#eff6ff,stroke:#2563eb,color:#172554
  classDef api fill:#ecfdf5,stroke:#059669,color:#064e3b
  classDef data fill:#f8fafc,stroke:#475569,color:#0f172a
  classDef docs fill:#fefce8,stroke:#a16207,color:#422006

  evaluator["Partner / Evaluator<br/>validates challenge and explores data"]
  user["Normal User<br/>creates and tracks orders"]
  admin["Admin User<br/>manages products and order status"]
  partnerSystem["Partner System<br/>optional direct REST integration"]
  browser["Web Browser<br/>runs the React UI"]

  subgraph softwareArch["Software Arch<br/>single Bun runtime"]
    ui["React UI<br/>users, products, orders and dashboards"]
    api["REST API<br/>Auth, User, Product and Order MVC modules"]
    openapi["OpenAPI Documentation<br/>/api/openapi and /api/openapi/json"]
  end

  db[("SQLite Database<br/>users, products, orders, order_items")]

  evaluator -- "uses" --> browser
  user -- "uses" --> browser
  admin -- "uses" --> browser
  evaluator -- "tests REST contract" --> api
  partnerSystem -- "Bearer token + JSON over HTTP" --> api
  browser -- "serves UI routes" --> ui
  ui -- "fetch /api through api-client.ts" --> api
  api -- "read/write users, products and orders" --> db
  api -- "publishes schema" --> openapi

  class evaluator,user,admin,partnerSystem actor
  class browser,ui app
  class api api
  class db data
  class openapi docs
  style softwareArch fill:#f8fafc,stroke:#334155,color:#0f172a
