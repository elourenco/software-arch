flowchart TD
  classDef boundary fill:#f0f9ff,stroke:#0284c7,color:#082f49
  classDef domain fill:#ecfdf5,stroke:#059669,color:#064e3b
  classDef data fill:#f8fafc,stroke:#475569,color:#0f172a
  classDef error fill:#fef2f2,stroke:#dc2626,color:#450a0a
  request["HTTP request<br/>/api/&lt;domain&gt;"]

  subgraph modulePattern["Feature module MVC contract"]
    route["&lt;domain&gt;.routes.ts<br/>Elysia route binding"]
    schema["&lt;domain&gt;.schema.ts<br/>Zod body, params, query and response DTOs"]
    controller["&lt;domain&gt;.controller.ts<br/>thin HTTP adapter"]
    service["&lt;domain&gt;.service.ts<br/>stateless business rules"]
    model["&lt;domain&gt;.model.ts<br/>domain types"]
    repository["&lt;domain&gt;.repository.ts<br/>prepared SQL and persistence boundary"]
    mapper["&lt;domain&gt;.mapper.ts<br/>DB row to public model"]
    domainErrors["&lt;domain&gt;.errors.ts<br/>domain-specific failures"]
  end

  authGuard["shared auth guard<br/>Bearer token to request user"]
  errorHandler["shared error handler<br/>AppError to stable HTTP response"]
  database[("SQLite<br/>users, products, orders, order_items")]
  response["HTTP response<br/>validated public payload"]

  subgraph implementedModules["Implemented modules"]
    auth["auth<br/>register, login, me, JWT"]
    user["user<br/>CRUD, count, list, search"]
    product["product<br/>SKU, name, stock quantity"]
    order["order<br/>multi-item order, status, stock transaction"]
  end

  request --> route
  route --> schema
  route --> authGuard
  route --> controller
  schema --> controller
  controller --> service
  service --> model
  service --> repository
  repository --> mapper
  repository --> database
  mapper --> service
  service --> controller
  controller --> response

  service --> domainErrors
  repository --> domainErrors
  domainErrors --> errorHandler
  errorHandler --> response

  authGuard --> auth
  auth -- "delegates user lookup and creation" --> user
  order -- "reads product stock and writes order_items" --> product
  order -- "owns status and cancel workflow" --> route
  product -. "follows pattern" .-> route
  user -. "follows pattern" .-> route
  auth -. "uses controller/service/schema pattern" .-> route

  class request,response boundary
  class route,schema,controller,authGuard,errorHandler boundary
  class service,model,auth,user,product,order domain
  class repository,mapper,database data
  class domainErrors error
  style modulePattern fill:#f8fafc,stroke:#334155,color:#0f172a
  style implementedModules fill:#fff7ed,stroke:#c2410c,color:#431407
